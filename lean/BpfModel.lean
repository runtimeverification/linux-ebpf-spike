/-- [bpf_model::verifier_c::range_within]:
    Source: 'model/src/verifier_c.rs', lines 761:0-776:1
    Visibility: public -/
def verifier_c.range_within
  (old : verifier_c.BpfRegState) (cur : verifier_c.BpfRegState) :
  Result Bool
  := do
  let b ← cnum_c.cnum64_is_subset old.r64 cur.r64
  if b
  then
    let b1 ← cnum_c.cnum32_is_subset old.r32 cur.r32
    if b1
    then
      if old.step <= 1#u16
      then ok true
      else
        let b2 ← cnum_c.cnum64_is_const cur.r64
        if b2
        then
          let i ← cnum_c.cnum64_smin cur.r64
          let i1 ← cnum_c.imod i old.step
          ok (i1 = old.base)
        else
          let i ← cur.step % old.step
          if i = 0#u16
          then
            let i1 ← lift (UScalar.hcast .I32 cur.base)
            let i2 ← lift (UScalar.hcast .I32 old.base)
            let i3 ← i1 - i2
            let i4 ← lift (UScalar.hcast .I32 old.step)
            let i5 ← i3 % i4
            ok (i5 = 0#i32)
          else ok false
    else ok false
  else ok false

