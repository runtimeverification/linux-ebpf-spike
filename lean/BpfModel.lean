def tnum_c.tnum_step (t : tnum_c.Tnum) (z : Std.U64) : Result Std.U64 := do
  let tmax ← lift (t.value ||| t.mask)
  if z >= tmax
  then ok tmax
  else
    if z < t.value
    then ok t.value
    else
      let d ← lift (core.num.U64.wrapping_sub z t.value)
      let i ← lift (~~~ t.mask)
      let i1 ← lift (d &&& i)
      let i2 ← tnum_c.fls64 i1
      let i3 ← 1#u64 <<< i2
      let carry_mask ← lift (core.num.U64.wrapping_sub i3 1#u64)
      let i4 ← lift (d ||| carry_mask)
      let i5 ← lift (~~~ t.mask)
      let filled ← lift (i4 ||| i5)
      let i6 ← lift (core.num.U64.wrapping_add filled 1#u64)
      let inc ← lift (i6 &&& t.mask)
      ok (t.value ||| inc)

