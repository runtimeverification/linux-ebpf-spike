def cnum_c.cnum64_cnum32_intersect
  (a : cnum_c.Cnum64) (b : cnum_c.Cnum32) : Result cnum_c.Cnum64 := do
  let i ← lift (UScalar.cast .U32 a.base)
  let i1 ← lift (core.num.U32.wrapping_sub b.base i)
  let b1 ← cnum_c.cnum64_is_empty a
  if b1
  then ok cnum_c.CNUM64_EMPTY
  else
    let b2 ← cnum_c.cnum32_is_empty b
    if b2
    then ok cnum_c.CNUM64_EMPTY
    else
      let b3 ← cnum_c.cnum32_urange_overflow { b with base := i1 }
      if b3
      then
        let i2 ← lift (core.num.U32.wrapping_add i1 b.size)
        let b1_max ← lift (UScalar.cast .U64 i2)
        let i3 ← lift (UScalar.cast .U32 a.size)
        let i4 ← lift (UScalar.cast .U64 i3)
        if i4 > b1_max
        then
          let i5 ← lift (UScalar.cast .U32 a.size)
          if i5 < i1
          then
            let i6 ← lift (UScalar.cast .U32 a.size)
            let i7 ← lift (UScalar.cast .U64 i6)
            let d ← i7 - b1_max
            let i8 ← a.size - d
            ok { a with size := i8 }
          else ok a
        else ok a
      else
        let i2 ← lift (UScalar.cast .U64 i1)
        if a.size < i2
        then ok cnum_c.CNUM64_EMPTY
        else
          let i3 ← lift (UScalar.cast .U64 i1)
          let i4 ← lift (core.num.U64.wrapping_add a.base i3)
          let i5 ← lift (UScalar.cast .U64 i1)
          let i6 ← a.size - i5
          let i7 ← i1 + b.size
          let b1_max ← lift (UScalar.cast .U64 i7)
          let i8 ← lift (UScalar.cast .U32 a.size)
          let i9 ← lift (UScalar.cast .U64 i8)
          let i10 ← lift (UScalar.cast .U64 i1)
          let d ←
            if i9 < i10
            then
              do
              let i11 ← lift (UScalar.cast .U32 a.size)
              let i12 ← lift (UScalar.cast .U64 i11)
              let i13 ← 1#u64 <<< 32#i32
              let i14 ← i13 - b1_max
              i12 + i14
            else
              do
              let i11 ← lift (UScalar.cast .U32 a.size)
              let i12 ← lift (UScalar.cast .U64 i11)
              if i12 >= b1_max
              then
                let i13 ← lift (UScalar.cast .U32 a.size)
                let i14 ← lift (UScalar.cast .U64 i13)
                i14 - b1_max
              else ok 0#u64
          if i6 < d
          then ok cnum_c.CNUM64_EMPTY
          else let i11 ← i6 - d
               ok { base := i4, size := i11 }

/-- [bpf_model::cnum_c::cnum64_intersect_linear]:
    Source: 'model/src/cnum_c.rs', lines 304:0-324:1
    Visibility: public -/
def cnum_c.cnum64_intersect_linear
  (input : cnum_c.Cnum64) (base : Std.U16) (step : Std.U16) :
  Result cnum_c.Cnum64
  := do
  let smin ← cnum_c.cnum64_smin input
  let smax ← cnum_c.cnum64_smax input
  if step <= 1#u16
  then ok input
  else
    let b ← cnum_c.cnum64_is_empty input
    if b
    then ok input
    else
      let b1 ← cnum_c.cnum64_srange_overflow input
      if b1
      then ok input
      else
        let i ← lift (UScalar.hcast .I64 base)
        let i1 ← cnum_c.imod smin step
        let i2 ← lift (UScalar.hcast .I64 i1)
        let i3 ← i - i2
        let d ← cnum_c.imod i3 step
        let i4 ← lift (IScalar.hcast .U64 smax)
        let i5 ← lift (IScalar.hcast .U64 smin)
        let i6 ← lift (core.num.U64.wrapping_sub i4 i5)
        let i7 ← lift (UScalar.cast .U64 d)
        if i6 < i7
        then ok cnum_c.CNUM64_EMPTY
        else
          let i8 ← lift (UScalar.hcast .I64 d)
          let lo ← smin + i8
          let i9 ← cnum_c.imod smax step
          let i10 ← lift (UScalar.hcast .I64 i9)
          let i11 ← lift (UScalar.hcast .I64 base)
          let i12 ← i10 - i11
          let d1 ← cnum_c.imod i12 step
          let i13 ← lift (UScalar.hcast .I64 d1)
          let hi ← smax - i13
          cnum_c.cnum64_from_srange lo hi

