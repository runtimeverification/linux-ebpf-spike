def verifier_c.scalar_step_scale
  (dst_reg : verifier_c.BpfRegState) (amount : Std.U64) :
  Result verifier_c.BpfRegState
  := do
  let i ← lift (UScalar.cast .U64 dst_reg.step)
  let prod ← lift (U64.checked_mul i amount)
  let step_fits ←
    match prod with
    | none => ok false
    | some p =>
      do
      let i1 ← lift (UScalar.cast .U64 core.num.U16.MAX)
      ok (p <= i1)
  if amount = 0#u64
  then verifier_c.reg_step_reset dst_reg
  else
    if step_fits
    then
      let i1 ← verifier_c.reg_smin dst_reg
      let i2 ← lift (UScalar.hcast .I64 amount)
      let o ← lift (I64.checked_mul i1 i2)
      let b := core.option.Option.is_none o
      if b
      then verifier_c.reg_step_reset dst_reg
      else
        let i3 ← verifier_c.reg_smax dst_reg
        let i4 ← lift (UScalar.hcast .I64 amount)
        let o1 ← lift (I64.checked_mul i3 i4)
        let b1 := core.option.Option.is_none o1
        if b1
        then verifier_c.reg_step_reset dst_reg
        else
          let step ←
            match prod with
            | none => ok 0#u16
            | some p => ok (UScalar.cast .U16 p)
          let i5 ← lift (UScalar.cast .U64 dst_reg.base)
          let i6 ← i5 * amount
          let i7 ← lift (UScalar.cast .U16 i6)
          ok { dst_reg with base := i7, step }
    else verifier_c.reg_step_reset dst_reg

