/- Smoke-test proof (task 5): tnum_add contains the sum of any two members of
   its inputs.  Definitions come from BpfModel.lean, generated by Aeneas
   (pinned pair) from rust/model, which is a port of kernel/bpf/tnum.c.

   Two proofs of the same statement:
   * `tnum_add_sound_bv` uses `bv_tac` (Aeneas's wrapper around `bv_decide`).
     It closes the goal but `#print axioms` shows the extra native-evaluation
     axiom of the LRAT checker (`..._native.bv_decide.ax_...`), so by the
     project rule it does not count as "proved".
   * `tnum_add_sound` is a manual proof whose axioms are only `propext`,
     `Classical.choice`, `Quot.sound`. -/
import BpfModel

open Aeneas Aeneas.Std Result

namespace bpf_model.tnum_c

/-- `x` is a member of the tnum `t`: every bit of `x` that `t` claims to know
    has the claimed value (the kernel's own membership test, see `tnum_in` and
    `__update_reg64_bounds`: `(x & ~t.mask) == t.value`). -/
def Tnum.mem (t : Tnum) (x : U64) : Prop :=
  x.bv &&& ~~~t.mask.bv = t.value.bv

/-- Soundness of `tnum_add`, closed by `bv_decide`.  Kept as documentation that
    the SAT route works; see `tnum_add_sound` for the axiom-clean proof. -/
theorem tnum_add_sound_bv (a b : Tnum) (x y : U64)
    (hx : a.mem x) (hy : b.mem y) :
    ∃ r, tnum_add a b = ok r ∧ r.mem (x.wrapping_add y) := by
  simp only [tnum_add, TNUM, lift, Tnum.mem] at *
  refine ⟨_, rfl, ?_⟩
  simp only [U64.wrapping_add_bv_eq, core.num.U64.wrapping_add_bv_eq, UScalar.bv_and,
    UScalar.bv_or, UScalar.bv_xor, UScalar.bv_not]
  bv_tac 64

/-! ### Manual proof

Notation (all `BitVec w`): `X`, `Y` are the members, `AM`, `BM` the masks,
`AV = X &&& ~~~AM`, `BV = Y &&& ~~~BM` the values, `SM = AM + BM`,
`SV = AV + BV`, `CHI = (SM + SV) ^^^ SV`, `MU = CHI ||| AM ||| BM`.
Goal: `(X + Y) &&& ~~~MU = SV &&& ~~~MU`.

Bit `i` of both sides is `false` unless `AM_i = BM_i = CHI_i = false`.  In
that case `X_i = AV_i`, `Y_i = BV_i`, and `CHI_i = false` says that the carry
into bit `i` of `SM + SV` equals `SM_i`, which (as `AM_i = BM_i = false`) is
the carry into bit `i` of `AM + BM`.  The remaining fact is that the carries
into bit `i` of `X + Y` and of `AV + BV` agree; that is a statement about the
residues mod `2^i` of the six operands, proved in `carry_nat`. -/

/-- Pure `Nat` core of the carry argument.  `N = 2^i`; `a, A, b, B, Xl, Yl` are
    the residues mod `N` of `AV, AM, BV, BM, X, Y`. -/
theorem carry_nat (N a A b B Xl Yl : Nat)
    (h1 : a + A < N) (h2 : b + B < N)
    (h3 : a ≤ Xl) (h4 : Xl ≤ a + A) (h5 : b ≤ Yl) (h6 : Yl ≤ b + B)
    (hc : (A + B ≥ N) ↔ ((A + B) % N + (a + b) % N ≥ N)) :
    (Xl + Yl ≥ N) ↔ (a + b ≥ N) := by
  rcases Nat.lt_or_ge (a + b) N with hab | hab
  · rw [Nat.mod_eq_of_lt hab] at hc
    rcases Nat.lt_or_ge (A + B) N with hAB | hAB
    · rw [Nat.mod_eq_of_lt hAB] at hc
      omega
    · rw [Nat.mod_eq_sub_mod hAB, Nat.mod_eq_of_lt (by omega)] at hc
      omega
  · omega

/-- `X &&& ~~~M` and `M` have no bit in common. -/
theorem and_not_and_self {w : Nat} (X M : BitVec w) :
    (X &&& ~~~M) &&& M = 0#w := by
  rw [BitVec.and_assoc, BitVec.not_and_self]
  simp

/-- `X &&& ~~~M` and `X &&& M` have no bit in common. -/
theorem and_not_and_and {w : Nat} (X M : BitVec w) :
    (X &&& ~~~M) &&& (X &&& M) = 0#w := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, BitVec.getLsbD_zero, hj, decide_true,
    Bool.true_and]
  cases X.getLsbD j <;> cases M.getLsbD j <;> rfl

/-- `X &&& ~~~M ||| X &&& M = X`. -/
theorem and_not_or_and {w : Nat} (X M : BitVec w) :
    (X &&& ~~~M) ||| (X &&& M) = X := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [BitVec.getLsbD_or, BitVec.getLsbD_and, BitVec.getLsbD_not, hi, decide_true,
    Bool.true_and]
  cases X.getLsbD i <;> cases M.getLsbD i <;> rfl

/-- The low `i` bits of `X &&& ~~~M` and of `M` are disjoint, so their
    residues mod `2^i` add up to less than `2^i`. -/
theorem low_disjoint_lt {w i : Nat} (X M : BitVec w) :
    (X &&& ~~~M).toNat % 2 ^ i + M.toNat % 2 ^ i < 2 ^ i := by
  rw [← BitVec.toNat_setWidth, ← BitVec.toNat_setWidth, ← BitVec.toNat_add_of_and_eq_zero]
  · exact BitVec.isLt _
  · rw [← BitVec.setWidth_and, and_not_and_self, BitVec.setWidth_zero]

/-- The residue of `X` mod `2^i` lies between the residue of `X &&& ~~~M` and
    that plus the residue of `M`. -/
theorem low_between {w i : Nat} (X M : BitVec w) :
    (X &&& ~~~M).toNat % 2 ^ i ≤ X.toNat % 2 ^ i ∧
    X.toNat % 2 ^ i ≤ (X &&& ~~~M).toNat % 2 ^ i + M.toNat % 2 ^ i := by
  rw [← BitVec.toNat_setWidth, ← BitVec.toNat_setWidth, ← BitVec.toNat_setWidth]
  have hdisj : BitVec.setWidth i (X &&& ~~~M) &&& BitVec.setWidth i (X &&& M) = 0#i := by
    rw [← BitVec.setWidth_and, and_not_and_and, BitVec.setWidth_zero]
  have h : BitVec.setWidth i X
      = BitVec.setWidth i (X &&& ~~~M) + BitVec.setWidth i (X &&& M) := by
    rw [BitVec.add_eq_or_of_and_eq_zero _ _ hdisj, ← BitVec.setWidth_or, and_not_or_and]
  have hle : (BitVec.setWidth i (X &&& M)).toNat ≤ (BitVec.setWidth i M).toNat := by
    rw [BitVec.setWidth_and, BitVec.toNat_and]
    exact Nat.and_le_right
  rw [h, BitVec.toNat_add_of_and_eq_zero hdisj]
  omega

/-- Residue mod `2^i` (`i ≤ w`) of a `BitVec w` sum. -/
theorem toNat_add_mod {w i : Nat} (hi : i ≤ w) (A B : BitVec w) :
    (A + B).toNat % 2 ^ i = (A.toNat % 2 ^ i + B.toNat % 2 ^ i) % 2 ^ i := by
  rw [BitVec.toNat_add, Nat.mod_mod_of_dvd _ (Nat.pow_dvd_pow 2 hi), Nat.add_mod]

/-- The carry argument: when the carries into bit `i` of `AM + BM` and of
    `(AM + BM) + (AV + BV)` agree, the carry into bit `i` of `X + Y` equals
    the carry into bit `i` of `AV + BV` (with `AV = X &&& ~~~AM`,
    `BV = Y &&& ~~~BM`). -/
theorem carry_mem {w i : Nat} (hi : i ≤ w) (X Y AM BM : BitVec w)
    (hchi : BitVec.carry i (AM + BM) ((X &&& ~~~AM) + (Y &&& ~~~BM)) false
      = BitVec.carry i AM BM false) :
    BitVec.carry i X Y false = BitVec.carry i (X &&& ~~~AM) (Y &&& ~~~BM) false := by
  simp only [BitVec.carry, Bool.toNat_false, Nat.add_zero, toNat_add_mod hi,
    decide_eq_decide] at *
  have h1 := low_disjoint_lt (i := i) X AM
  have h2 := low_disjoint_lt (i := i) Y BM
  have h3 := low_between (i := i) X AM
  have h4 := low_between (i := i) Y BM
  exact carry_nat (2 ^ i) _ _ _ _ _ _ h1 h2 h3.1 h3.2 h4.1 h4.2 hchi.symm

/-- Bit-level statement of `tnum_add` soundness over plain bit-vectors of any
    width. -/
theorem tnum_add_bv {w : Nat} (X Y AV AM BV BM : BitVec w)
    (hx : X &&& ~~~AM = AV) (hy : Y &&& ~~~BM = BV) :
    (X + Y) &&& ~~~(((AM + BM) + (AV + BV)) ^^^ (AV + BV) ||| AM ||| BM)
      = (AV + BV) &&& ~~~(((AM + BM) + (AV + BV)) ^^^ (AV + BV) ||| AM ||| BM) := by
  subst hx hy
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  have key := carry_mem (Nat.le_of_lt hi) X Y AM BM
  simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_xor,
    BitVec.getLsbD_add hi, hi, decide_true, Bool.true_and]
  -- Abstract the four carries and the four bits; the rest is a finite Boolean
  -- check (8 Boolean variables).
  generalize BitVec.carry i X Y false = cXY at key ⊢
  generalize BitVec.carry i (X &&& ~~~AM) (Y &&& ~~~BM) false = cAB at key ⊢
  generalize BitVec.carry i AM BM false = cSM at key ⊢
  generalize BitVec.carry i (AM + BM) ((X &&& ~~~AM) + (Y &&& ~~~BM)) false = cS at key ⊢
  generalize X.getLsbD i = xi
  generalize Y.getLsbD i = yi
  generalize AM.getLsbD i = ami
  generalize BM.getLsbD i = bmi
  revert key cXY cAB cSM cS xi yi ami bmi
  decide

/-- Soundness of `tnum_add`: for any members `x` of `a` and `y` of `b`, the
    64-bit wrapping sum `x + y` is a member of `tnum_add a b`.  Also states that
    `tnum_add` never fails (returns `ok`).  Manual proof, standard axioms only. -/
theorem tnum_add_sound (a b : Tnum) (x y : U64)
    (hx : a.mem x) (hy : b.mem y) :
    ∃ r, tnum_add a b = ok r ∧ r.mem (x.wrapping_add y) := by
  simp only [tnum_add, TNUM, lift, Tnum.mem] at *
  refine ⟨_, rfl, ?_⟩
  simp only [U64.wrapping_add_bv_eq, core.num.U64.wrapping_add_bv_eq, UScalar.bv_and,
    UScalar.bv_or, UScalar.bv_xor, UScalar.bv_not]
  exact tnum_add_bv _ _ _ _ _ _ hx hy

#print axioms tnum_add_sound_bv
#print axioms tnum_add_sound

end bpf_model.tnum_c
